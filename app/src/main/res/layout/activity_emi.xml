<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmiCalculator">

    <com.example.nothcalculator.HeadingView
        android:id="@+id/emiHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/emiScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emiHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Card 1: Input Parameters -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="0dp"
                        android:text="LOAN PARAMETERS" />

                    <!-- Principal Amount Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.04"
                        android:text="PRINCIPAL AMOUNT"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/ndot"
                            android:text="$"
                            android:textColor="@color/red"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/etPrincipal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/ndot"
                            android:hint="100000"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="@color/settings_subtitle_dark"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Quick Principal Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAdd10k"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="+10K"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAdd50k"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="+50K"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAdd100k"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="+100K"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipClearPrincipal"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="CLR"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <View
                        style="@style/SettingsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp" />

                    <!-- Interest Rate Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.04"
                        android:text="INTEREST RATE (% P.A.)"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/ndot"
                            android:text="%"
                            android:textColor="@color/nothing_yellow"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/etInterestRate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/ndot"
                            android:hint="8.5"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="@color/settings_subtitle_dark"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Quick Rate Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipRate75"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="7.5%"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipRate85"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="8.5%"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipRate10"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="10%"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipRate12"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="12%"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <View
                        style="@style/SettingsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp" />

                    <!-- Tenure Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:letterSpacing="0.04"
                            android:text="LOAN TENURE"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="11sp" />

                        <!-- Years / Months Unit Toggle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_mode_badge"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/btnTenureYears"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/red"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/ndot"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="YR"
                                android:textColor="@color/full_white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/btnTenureMonths"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/ndot"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="MO"
                                android:textColor="@color/settings_subtitle_dark"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTenureUnitIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/ndot"
                            android:text="⌛"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/etTenure"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/ndot"
                            android:hint="5"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="@color/settings_subtitle_dark"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Quick Tenure Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTenure1"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="1Y"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTenure3"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="3Y"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTenure5"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="5Y"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTenure10"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="10Y"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTenure20"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="20Y"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Calculate & Reset Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReset"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:letterSpacing="0.06"
                            android:text="RESET"
                            android:textSize="14sp"
                            app:cornerRadius="100dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalculate"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="2"
                            android:backgroundTint="@color/red"
                            android:fontFamily="@font/ndot"
                            android:letterSpacing="0.06"
                            android:text="CALCULATE"
                            android:textColor="@color/full_white"
                            android:textSize="14sp"
                            app:cornerRadius="100dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Calculation Summary -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.08"
                        android:text="CALCULATION SUMMARY"
                        android:textColor="@color/nothing_yellow"
                        android:textSize="12sp" />

                    <!-- Monthly EMI Highlight -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.04"
                        android:text="MONTHLY EMI"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEmiAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ndot"
                            android:text="2,051.65"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/noto_sans"
                            android:text="/ month"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Breakdown Bar -->
                    <LinearLayout
                        android:id="@+id/barContainer"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_mode_badge"
                        android:clipToOutline="true"
                        android:orientation="horizontal"
                        android:weightSum="100">

                        <View
                            android:id="@+id/viewPrincipalBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="81"
                            android:background="@color/settings_subtitle_dark" />

                        <View
                            android:id="@+id/viewInterestBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="19"
                            android:background="@color/red" />
                    </LinearLayout>

                    <!-- Breakdown Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Principal indicator"
                            android:src="@drawable/dot_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/noto_sans"
                            android:text="Principal Amount"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTotalPrincipal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ndot"
                            android:text="$ 100,000"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Interest indicator"
                            android:src="@drawable/dot_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/noto_sans"
                            android:text="Total Interest"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTotalInterest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ndot"
                            android:text="$ 23,099"
                            android:textColor="@color/red"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        style="@style/SettingsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Payable indicator"
                            android:src="@drawable/dot_yellow" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/noto_sans"
                            android:text="Total Payable"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTotalPayable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ndot"
                            android:text="$ 123,099"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
