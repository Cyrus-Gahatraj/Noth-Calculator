<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboardingMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/onboardingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.08"
            android:text="NOTH // 00"
            android:textColor="@color/red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.06"
            android:padding="8dp"
            android:text="SKIP"
            android:textColor="@color/settings_subtitle_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Pager Area -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardingViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/onboardingTopBar"
        app:layout_constraintBottom_toTopOf="@id/onboardingBottomBar" />

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/onboardingBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Indicator Dots -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dot0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:src="@drawable/indicator_dot_active_red"
                android:contentDescription="Page 1" />

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:src="@drawable/indicator_dot_inactive"
                android:contentDescription="Page 2" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/indicator_dot_inactive"
                android:contentDescription="Page 3" />
        </LinearLayout>

        <!-- Next / Get Started Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:paddingHorizontal="28dp"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.08"
            android:text="NEXT"
            android:textColor="@color/full_white"
            android:textSize="14sp"
            app:backgroundTint="@color/red"
            app:cornerRadius="25dp"
            app:elevation="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
