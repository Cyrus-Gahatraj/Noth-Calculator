<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Modes">

    <com.example.nothcalculator.HeadingView
        android:id="@+id/modeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/modeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeHeader">

        <!-- Default Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/defaultCalc"
            style="@style/SettingsCard"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:text="01"
                        android:textSize="12sp"
                        android:textColor="@color/settings_subtitle_dark" />

                    <ImageView
                        android:id="@+id/dotActiveDefault"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/dot_red"
                        android:visibility="gone"
                        android:contentDescription="Active mode indicator" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:fontFamily="@font/ndot"
                    android:text="+-×÷"
                    android:letterSpacing="0.08"
                    android:textSize="26sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ndot"
                    android:letterSpacing="0.06"
                    android:text="DEFAULT"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/noto_sans"
                    android:text="Standard mode"
                    android:textSize="11sp"
                    android:textColor="@color/settings_subtitle_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scientific Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scientificCalc"
            style="@style/SettingsCard"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:text="02"
                        android:textSize="12sp"
                        android:textColor="@color/settings_subtitle_dark" />

                    <ImageView
                        android:id="@+id/dotActiveScientific"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/dot_yellow"
                        android:visibility="gone"
                        android:contentDescription="Active mode indicator" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:fontFamily="@font/ndot"
                    android:text="f(x)"
                    android:letterSpacing="0.08"
                    android:textSize="26sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ndot"
                    android:letterSpacing="0.06"
                    android:text="SCIENTIFIC"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/noto_sans"
                    android:text="Advanced &amp; trig"
                    android:textSize="11sp"
                    android:textColor="@color/settings_subtitle_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>