<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Modes">

    <com.example.nothcalculator.HeadingView
        android:id="@+id/modeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/modeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeHeader">

        <!-- Row 1: Default & Scientific -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Default Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/defaultCalc"
                style="@style/SettingsCard"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:text="01"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/dotActiveDefault"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Active mode indicator"
                            android:src="@drawable/dot_red"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="+-×÷"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.06"
                        android:text="DEFAULT"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/noto_sans"
                        android:text="Standard mode"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scientific Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scientificCalc"
                style="@style/SettingsCard"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:text="02"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/dotActiveScientific"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Active mode indicator"
                            android:src="@drawable/dot_yellow"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="f(x)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.06"
                        android:text="SCIENTIFIC"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/noto_sans"
                        android:text="Advanced &amp; trig"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 2: EMI & Graph -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- EMI Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emiCalc"
                style="@style/SettingsCard"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:text="03"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/dotActiveEmi"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Active mode indicator"
                            android:src="@drawable/dot_red"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="% / $"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.06"
                        android:text="EMI"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/noto_sans"
                        android:text="Loan &amp; mortgage"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Graph Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/graphCalc"
                style="@style/SettingsCard"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ndot"
                            android:text="04"
                            android:textColor="@color/settings_subtitle_dark"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/dotActiveGraph"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="Active mode indicator"
                            android:src="@drawable/dot_yellow"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/ndot"
                        android:gravity="center"
                        android:letterSpacing="0.04"
                        android:text="y=f(x)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ndot"
                        android:letterSpacing="0.06"
                        android:text="GRAPH"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/noto_sans"
                        android:text="Function plotter"
                        android:textColor="@color/settings_subtitle_dark"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>