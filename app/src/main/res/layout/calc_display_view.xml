<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/btnSettings"
        style="@style/SettingIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:contentDescription="Settings"
        android:src="@drawable/baseline_settings_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvModeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_mode_badge"
        android:fontFamily="@font/ndot"
        android:letterSpacing="0.06"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="DEG"
        android:textSize="12sp"
        android:textColor="@color/nothing_yellow"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btnSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnSettings" />

    <HorizontalScrollView
        android:id="@+id/expressionScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/resultScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSettings"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/expressionView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="end"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.04"
            android:textColor="?attr/colorOnBackground"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="50sp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/resultScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expressionScrollView">

        <TextView
            android:id="@+id/resultView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="end"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.04"
            android:textColor="?attr/colorOnBackground"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="none"
            android:paddingVertical="4dp"
            android:textSize="44sp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>